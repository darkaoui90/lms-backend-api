# Configuration du serveur
PORT=5000
NODE_ENV=development

# Configuration de la base de données MongoDB
# Si vous utilisez Docker Compose avec le port par défaut (27018:27017) :
MONGO_URI=mongodb://localhost:27018/lms_db

# Si vous utilisez une instance MongoDB locale standard sur le port 27017 :
# MONGO_URI=mongodb://localhost:27017/lms_db
